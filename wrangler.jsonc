{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "profiles-panorama-sg",
  "compatibility_date": "2026-04-04",
  // Only handles /oauth/* (GitHub sign-in for the /admin editor) and /auth/*,
  // /api/me (scholar self-service at /edit); every other request is served
  // straight from the static assets.
  "main": "worker/index.ts",
  // GitHub accounts allowed to sign in to the /admin editor, comma-separated
  // (e.g. "WENSHAO521,another-editor"). Everyone else is refused at sign-in.
  "vars": {
    "ALLOWED_GITHUB_USERS": "WENSHAO521",
    // Alibaba Cloud DirectMail (邮件推送) sender for the /edit login links:
    // the 发信地址 set up in the DirectMail console, and its region
    // (cn-hangzhou, ap-southeast-1, ...).
    "ALIYUN_DM_ACCOUNT": "notification@mail.panorama-sg.de",
    "ALIYUN_DM_REGION": "cn-hangzhou"
  },
  "observability": {
    "enabled": true
  },
  // Astro builds the static site into dist/.
  // `wrangler deploy` runs the build first, so no separate build step is needed.
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Without this, browser navigations to /oauth/* get the 404 page instead
    // of reaching the Worker.
    "run_worker_first": ["/oauth/*", "/auth/*", "/api/me"]
  }
}
