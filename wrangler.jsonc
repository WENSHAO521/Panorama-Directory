{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "profiles-panorama-sg",
  "compatibility_date": "2026-04-04",
  "observability": {
    "enabled": true
  },
  // Static site: Astro builds into dist/, which is the only thing deployed.
  // `wrangler deploy` runs the build first, so no separate build step is needed.
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
