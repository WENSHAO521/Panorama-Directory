# The editor holds a GitHub token, so it must not be framed by other sites
# or indexed by search engines.
/admin
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  X-Robots-Tag: noindex, nofollow
  Referrer-Policy: no-referrer
/admin/*
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  X-Robots-Tag: noindex, nofollow
  Referrer-Policy: no-referrer

# Built files under /_astro carry a content hash in their name, so a changed
# file always gets a new URL: browsers can keep them for a year without
# asking again. Without this every page view re-checked each image and font.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
/assets/fonts/*
  Cache-Control: public, max-age=2592000
/assets/logos/*
  Cache-Control: public, max-age=86400
