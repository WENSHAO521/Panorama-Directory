---
// Self-service editor: a scholar signs in with a link mailed to them and
// edits their own entry, or submits a new one. The sign-in and saving live in worker/selfservice.ts;
// the form is built by src/scripts/edit.ts from what /api/me returns.
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Edit your profile" description="Scholars on the editorial board can sign in here to update their own profile or submit a new one.">
  <meta slot="head" name="robots" content="noindex, nofollow" />

  <section class="border-b border-rule bg-surface">
    <div class="wrap py-10 md:py-12">
      <p class="kicker mb-2">For board members · 编委自助编辑</p>
      <h1 class="mb-3 text-3xl font-semibold tracking-tight md:text-[2.5rem]">Edit your profile</h1>
      <p class="max-w-2xl text-muted">
        Sign in with your email address to update your profile, or to submit one if you are not listed yet. Everything you submit is reviewed by the editorial office before it appears on the site.
        <span class="mt-1 block text-sm">用邮箱登录即可编辑您的个人页面；尚未收录的编委也可以在这里提交。所有提交由编辑部审核后才会显示在网站上。</span>
      </p>
    </div>
  </section>

  <div class="wrap py-10 md:py-12">
    <p id="status" class="text-muted" role="status">Loading… 加载中…</p>

    <!-- Signed out -->
    <div id="signin" class="hidden max-w-md">
      <div id="signin-error" class="mb-5 hidden rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800" role="alert"></div>
      <div class="rounded-lg border border-rule p-6">
        <h2 class="mb-1 text-lg font-semibold">Sign in · 登录</h2>
        <p class="mb-5 text-sm text-muted">We will email you a one-time sign-in link. 我们会给您的邮箱发送一次性登录链接。</p>


        <form id="email-form" class="hidden">
          <label for="email" class="label mb-1.5 block">Your email · 您的邮箱</label>
          <input id="email" name="email" type="email" required autocomplete="email" class="mb-3 block w-full rounded-md border-rule text-sm focus:border-brand-600 focus:ring-brand-600" placeholder="you@university.edu" />
          <button type="submit" class="btn-primary w-full">Send link · 发送链接</button>
          <p id="email-sent" class="mt-3 hidden text-sm text-muted" role="status">
            A sign-in link is on its way. It works for 20 minutes; check your spam folder if it does not arrive.
            <span class="block">登录链接已发出，20 分钟内有效。没收到请查看垃圾邮件。</span>
          </p>
        </form>

        <p id="none" class="hidden text-sm text-muted">Sign-in is not available yet. 登录功能尚未开通。</p>
      </div>
      <p class="mt-5 text-sm text-muted">
        Already listed, but signed in to a blank form? Your page is under a different address. Write to <a class="link" href="mailto:directory.admin@panorama-sg.com">directory.admin@panorama-sg.com</a> and we will add this one.
        <span class="block">已在名录中，登录后却是空白表单？说明您的页面登记的是另一个邮箱，请写信给我们添加。</span>
      </p>
      <p class="mt-5 border-t border-rule pt-5 text-sm text-muted">
        Editorial office staff: <a class="link" href="/admin/">sign in to the editor</a>. 编辑部人员请从这里进入后台。
      </p>
    </div>

    <!-- Signed in -->
    <div id="editor" class="hidden">
      <div class="mb-8 flex flex-wrap items-center justify-between gap-4 border-b border-rule pb-5">
        <p class="text-sm text-muted">Signed in as <strong id="who" class="font-medium text-ink"></strong><span id="view-wrap" class="hidden"> · <a id="view" class="link" href="#">View live page · 查看当前页面</a></span></p>
        <form method="post" action="/auth/logout"><button class="btn-secondary py-1.5">Sign out · 退出</button></form>
      </div>
      <div id="new" class="mb-8 hidden rounded-md border border-brand-600/20 bg-brand-50 px-4 py-3 text-sm text-brand">
        This address is not linked to a page in the directory yet, so you are creating a new profile. If you are already listed under another address, please write to us instead of submitting a second page.
        <span class="block">这个邮箱还没有对应的个人页面，您正在新建一页。如果您已经在名录中（用的是别的邮箱），请联系我们，不要重复提交。</span>
      </div>
      <div id="pending" class="mb-8 hidden rounded-md border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900">
        Your last changes are waiting for review; you are editing that version. You can keep making changes.
        <span class="block">您上次提交的修改正在等待审核，下面显示的是那个版本，可以继续修改。</span>
      </div>
      <form id="form" class="grid min-w-0 gap-10" novalidate></form>
      <div class="sticky bottom-0 z-10 mt-10 flex flex-wrap items-center gap-4 border-t border-rule bg-paper py-4">
        <button id="save" type="button" class="btn-primary">Submit for review · 提交审核</button>
        <p id="save-status" class="text-sm text-muted" role="status"></p>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import "../scripts/edit";
</script>
