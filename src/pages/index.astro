---
import BaseLayout from "../layouts/BaseLayout.astro";
import ScholarCard from "../components/ScholarCard.astro";
import SectionHeading from "../components/SectionHeading.astro";
import SearchIndex from "../components/SearchIndex.astro";
import Icon from "../components/Icon.astro";
import JournalCover from "../components/JournalCover.astro";
import { getScholars, getBoard, publicationCount, journalsOf, JOURNALS } from "../lib/scholars";

const scholars = await getScholars();
const board = await getBoard();
const allChiefs = board.find((g) => g.key === "chief")?.members ?? [];
// The home page shows one row: members with a photo first (editors-in-chief
// before co- and deputy editors), then the rest in editorial order.
const HOME_CHIEFS = 4;
const chiefs = [...allChiefs]
  .sort(
    (a, b) =>
      Number(!a.data.photo) - Number(!b.data.photo) ||
      Number(!/^editor-in-chief/i.test(a.data.role)) - Number(!/^editor-in-chief/i.test(b.data.role)) ||
      a.data.order - b.data.order,
  )
  .slice(0, HOME_CHIEFS);

// Research fields ranked by how many members list them.
const fieldCounts = new Map<string, { label: string; n: number }>();
for (const s of scholars)
  for (const k of s.data.keywords) {
    if (/editor/i.test(k)) continue; // a role some profiles list as a keyword, not a field
    const key = k.toLowerCase();
    const e = fieldCounts.get(key) ?? { label: k, n: 0 };
    e.n++;
    fieldCounts.set(key, e);
  }
const fields = [...fieldCounts.values()].sort((a, b) => b.n - a.n || a.label.localeCompare(b.label));
const topFields = fields.slice(0, 8);
const topMax = topFields[0]?.n ?? 1;
const moreFields = fields.slice(8).filter((f) => f.n > 1);

const journals = JOURNALS.map((j) => ({ ...j, count: scholars.filter((s) => journalsOf(s).includes(j)).length }));

const stats = [
  { value: scholars.length, label: "Board members" },
  { value: new Set(scholars.map((s) => s.data.affiliation)).size, label: "Affiliations" },
  { value: fields.length, label: "Research fields" },
  { value: scholars.reduce((n, s) => n + publicationCount(s), 0), label: "Publications listed" },
];
---

<BaseLayout
  title="Global Editorial Directory"
  description="Discover the international network of scholars, principal investigators and editorial board members of Panorama Scholarly Group."
  active="home"
>
  <section class="border-b border-rule">
    <div class="wrap grid items-center gap-12 pt-12 pb-16 md:pt-20 md:pb-24 lg:grid-cols-12 lg:gap-16">
      <div class="min-w-0 lg:col-span-7">
        <p class="kicker mb-4">Panorama Scholarly Group · Editorial directory</p>
        <h1 class="mb-6 text-[2.5rem] leading-[1.05] font-medium tracking-[-0.03em] text-ink md:text-[3.5rem] md:leading-[1.04] xl:text-[4rem]">
          The people behind our journals
        </h1>
        <p class="mb-10 max-w-xl text-lg leading-relaxed text-muted">
          Editors-in-chief, board members and editorial staff of Panorama Scholarly Group, each with their affiliation, research fields and ORCID iD.
        </p>

        <div class="relative max-w-xl" id="home-search">
          <label for="global-search" class="sr-only">Search scholars by name, affiliation, research field or publication</label>
          <div class="flex h-14 items-center rounded-lg border border-ink/15 bg-paper pr-3 pl-4 shadow-[0_1px_2px_rgb(0_0_0/0.05)] transition-colors focus-within:border-brand-600 focus-within:ring-4 focus-within:ring-brand-600/10">
            <Icon name="search" class="text-faint" />
            <input
              type="search"
              id="global-search"
              autocomplete="off"
              role="combobox"
              aria-expanded="false"
              aria-controls="search-results"
              aria-autocomplete="list"
              class="h-full w-full border-0 bg-transparent px-3 text-base focus:ring-0 focus:outline-none"
              placeholder="Search by name, institution or field"
            />
            <kbd class="hidden h-6 min-w-6 items-center justify-center rounded-sm border border-rule px-1.5 font-mono text-xs text-faint md:inline-flex">/</kbd>
          </div>
          <ul
            id="search-results"
            role="listbox"
            class="absolute top-full right-0 left-0 z-40 mt-2 hidden max-h-[26rem] overflow-y-auto rounded-lg border border-rule bg-paper text-ink shadow-[0_8px_24px_rgb(0_0_0/0.08)]"
          >
          </ul>
        </div>
        <p class="mt-4 text-sm text-faint">
          Try <a class="link" href="/directory?q=Public%20Health">Public Health</a>, <a class="link" href="/directory?q=Musicology">Musicology</a> or <a class="link" href="/directory?q=Kookmin">Kookmin University</a>
        </p>
      </div>

      <div class="min-w-0 lg:col-span-5">
        <ul class="grid grid-cols-2 gap-4 sm:grid-cols-4 lg:grid-cols-2 w-full lg:gap-6 xl:ml-auto xl:max-w-[30rem]">
          {
            journals.map((j) => (
              <li>
                <JournalCover title={j.title} cover={j.cover} thumb={j.thumb} cloth={j.cloth} count={j.count} href={`/directory?q=${encodeURIComponent(j.match)}`} />
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="border-b border-rule bg-surface">
    <dl class="wrap grid grid-cols-2 md:grid-cols-4">
      {
        stats.map((s, i) => (
          <div class:list={["flex flex-col-reverse gap-1 py-6", i % 2 === 1 && "pl-6 md:pl-0", i > 0 && "md:border-l md:border-rule md:pl-6", i > 1 && "border-t border-rule md:border-t-0"]}>
            <dt class="text-sm text-muted">{s.label}</dt>
            <dd class="tabular text-3xl font-medium tracking-[-0.02em]">{s.value}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="wrap py-16 md:py-24">
    <SectionHeading kicker="Leadership" title="Editors-in-chief">
      <a href="/directory" class="link text-sm">All {allChiefs.length} editors-in-chief</a>
    </SectionHeading>
    <div class="grid gap-4 sm:grid-cols-2 md:gap-6 lg:grid-cols-4">
      {chiefs.map((s, i) => <ScholarCard scholar={s} eager={i < 4} />)}
    </div>
  </section>

  <section class="border-t border-rule">
    <div class="wrap grid gap-12 py-16 md:py-24 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-4">
        <p class="kicker mb-1">Browse</p>
        <h2 class="mb-4 text-2xl font-medium tracking-tight md:text-[1.75rem]">Research fields</h2>
        <p class="max-w-sm leading-relaxed text-muted">
          The {fields.length} fields board members list on their profiles, ranked by how many members work in each.
        </p>
      </div>
      <div class="lg:col-span-8">
        <ol class="divide-y divide-rule border-y border-rule">
          {
            topFields.map((f) => (
              <li>
                <a href={`/directory?q=${encodeURIComponent(f.label)}`} class="group grid h-12 grid-cols-[1fr_auto] items-center gap-4 transition-colors hover:bg-surface sm:grid-cols-[14rem_1fr_auto] sm:px-2">
                  <span class="truncate text-ink group-hover:text-brand-600">{f.label}</span>
                  <span class="hidden h-1.5 rounded-full bg-surface sm:block" aria-hidden="true">
                    <span class="block h-full rounded-full bg-brand/80" style={`width:${(f.n / topMax) * 100}%`} />
                  </span>
                  <span class="tabular w-6 text-right text-sm text-faint">{f.n}</span>
                </a>
              </li>
            ))
          }
        </ol>
        <ul class="mt-6 flex flex-wrap gap-2">
          {
            moreFields.map((f) => (
              <li>
                <a href={`/directory?q=${encodeURIComponent(f.label)}`} class="tag h-8 gap-2 px-3 text-sm text-ink transition-colors duration-150 hover:border-ink/25 hover:bg-surface">
                  {f.label}
                  <span class="tabular text-faint">{f.n}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="bg-brand text-paper">
    <div class="wrap grid gap-8 py-16 md:grid-cols-12 md:items-end md:gap-12 md:py-20">
      <div class="md:col-span-7">
        <p class="mb-2 text-sm text-paper/65">Join the network</p>
        <h2 class="mb-3 text-[1.75rem] font-medium tracking-tight md:text-[2.25rem]">Joining the editorial board</h2>
        <p class="max-w-xl leading-relaxed text-paper/75">
          If you are an academic interested in joining our editorial board or have inquiries regarding our scholarly network, please contact the directory administration.
        </p>
      </div>
      <div class="flex flex-col items-start gap-3 md:col-span-5 md:items-end">
        <div class="flex flex-wrap gap-3">
          <a href="mailto:directory.admin@panorama-sg.com" class="btn bg-paper text-brand hover:bg-brand-50"><Icon name="mail" class="text-lg!" /> Email the directory office</a>
          <a href="/contact" class="btn border border-paper/25 text-paper hover:bg-paper/10">All contact options</a>
        </div>
        <p class="text-sm text-paper/60">directory.admin@panorama-sg.com</p>
      </div>
    </div>
  </section>

  <SearchIndex />
</BaseLayout>

<script>
  import { loadIndex, search, escapeHtml } from "../lib/search";

  const input = document.getElementById("global-search") as HTMLInputElement;
  const results = document.getElementById("search-results") as HTMLUListElement;
  const index = loadIndex();
  let active = -1;

  const open = (show: boolean) => {
    results.classList.toggle("hidden", !show);
    input.setAttribute("aria-expanded", String(show));
    if (!show) active = -1;
  };

  const highlight = (text: string, q: string) => {
    const safe = escapeHtml(text);
    const words = q.trim().split(/\s+/).filter(Boolean).map((w) => w.replace(/[.*+?^${}()|[\]\\]/g, "\\$&"));
    return words.length ? safe.replace(new RegExp(`(${words.join("|")})`, "gi"), '<mark class="bg-brand-50 text-brand">$1</mark>') : safe;
  };

  const render = () => {
    const q = input.value.trim();
    if (!q) return open(false);
    const matches = search(index, q);
    results.innerHTML = matches.length
      ? matches
          .map(
            (m, i) => `<li role="option" id="opt-${i}"><a href="${m.url}" class="block border-b border-rule px-4 py-3 transition-colors hover:bg-surface">
              <span class="block font-medium text-ink">${highlight(m.name, q)}</span>
              <span class="mt-0.5 block text-sm text-muted">${highlight(m.affiliation, q)}</span></a></li>`,
          )
          .join("") +
        `<li><a href="/directory?q=${encodeURIComponent(q)}" class="block px-4 py-3 text-sm font-medium text-brand-600 hover:underline">Show all results in the directory</a></li>`
      : `<li class="px-4 py-4 text-sm text-muted">No matches. Browse the <a class="link" href="/directory">full directory</a>.</li>`;
    active = -1;
    open(true);
  };

  const options = () => [...results.querySelectorAll<HTMLElement>("[role=option]")];
  const move = (dir: number) => {
    const opts = options();
    if (!opts.length) return;
    active = (active + dir + opts.length) % opts.length;
    opts.forEach((o, i) => o.firstElementChild!.classList.toggle("bg-surface", i === active));
    input.setAttribute("aria-activedescendant", opts[active].id);
    opts[active].scrollIntoView({ block: "nearest" });
  };

  input.addEventListener("input", render);
  input.addEventListener("focus", render);
  input.addEventListener("keydown", (e) => {
    if (e.key === "ArrowDown") (e.preventDefault(), move(1));
    else if (e.key === "ArrowUp") (e.preventDefault(), move(-1));
    else if (e.key === "Enter") {
      const target = options()[active]?.querySelector("a") ?? results.querySelector("a");
      if (target) location.href = target.getAttribute("href")!;
    } else if (e.key === "Escape") open(false);
  });
  document.addEventListener("click", (e) => {
    if (!document.getElementById("home-search")!.contains(e.target as Node)) open(false);
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "/" && document.activeElement !== input) (e.preventDefault(), input.focus());
  });
</script>
