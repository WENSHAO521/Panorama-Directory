---
import BaseLayout from "../layouts/BaseLayout.astro";
import ScholarCard from "../components/ScholarCard.astro";
import SectionHeading from "../components/SectionHeading.astro";
import SearchIndex from "../components/SearchIndex.astro";
import Icon from "../components/Icon.astro";
import { getScholars, getFeatured, publicationCount, profileUrl } from "../lib/scholars";

const scholars = await getScholars();
const featured = await getFeatured(3);
const fields = new Set(scholars.flatMap((s) => s.data.keywords.map((k) => k.toLowerCase())));
const stats = [
  { value: scholars.length, label: "Board members" },
  { value: fields.size, label: "Research fields" },
  { value: scholars.reduce((n, s) => n + publicationCount(s), 0), label: "Listed publications" },
];
// Register: every member grouped by the initial of their family name.
const register = Object.entries(
  Object.groupBy(
    [...scholars].sort((a, b) => lastName(a.data.name).localeCompare(lastName(b.data.name))),
    (s) => lastName(s.data.name)[0].toUpperCase(),
  ),
);
function lastName(name: string) {
  return name.replace(/\(.*?\)/g, "").trim().split(/\s+/).at(-1)!;
}
---

<BaseLayout
  title="Global Editorial Directory"
  description="Discover the international network of scholars, principal investigators and editorial board members of Panorama Scholarly Group."
  active="home"
>
  <section class="wrap grid-12 gap-y-8 pt-14 pb-16 md:pt-24 md:pb-24">
    <p class="label col-span-4 md:col-span-3 md:pt-3">Official researcher database</p>
    <div class="col-span-4 md:col-span-9">
      <h1 class="headline mb-10 text-[clamp(3rem,9vw,8rem)]">Global<br />Editorial<br />Directory<span class="text-signal">.</span></h1>
      <p class="mb-12 max-w-2xl text-lg leading-snug md:text-2xl">
        Discover the international network of scholars, principal investigators, and editorial board members driving rigorous peer review across our publishing group.
      </p>

      <div class="relative max-w-3xl" id="home-search">
        <label for="global-search" class="label mb-2 block">Search by name, institution, research field or publication</label>
        <div class="flex items-center border-b-2 border-ink bg-paper focus-within:border-signal">
          <Icon name="search" class="mr-3 text-3xl!" />
          <input
            type="search"
            id="global-search"
            autocomplete="off"
            role="combobox"
            aria-expanded="false"
            aria-controls="search-results"
            aria-autocomplete="list"
            class="w-full border-0 bg-transparent px-0 py-3 text-xl placeholder:text-faint focus:ring-0 focus:outline-none md:text-3xl md:tracking-tight"
            placeholder="e.g. Kookmin, dance, governance"
          />
          <kbd class="hidden border border-rule px-1.5 py-0.5 font-mono text-xs text-muted md:block">/</kbd>
        </div>
        <ul
          id="search-results"
          role="listbox"
          class="absolute top-full right-0 left-0 z-40 hidden max-h-[26rem] overflow-y-auto border border-t-0 border-ink bg-paper"
        >
        </ul>
      </div>
    </div>
  </section>

  <section class="border-y border-ink">
    <dl class="wrap grid-12">
      {
        stats.map((s, i) => (
          <div class:list={["col-span-4 flex items-baseline justify-between border-rule py-5 md:col-span-3 md:block md:border-l md:py-8 md:pl-6", i === 0 ? "md:col-start-4" : "border-t md:border-t-0"]}>
            <dt class="label md:mt-2">{s.label}</dt>
            <dd class="headline tabular order-first text-5xl md:text-7xl">{s.value}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="wrap py-20 md:py-28">
    <SectionHeading index="01" label="Board members" title="Featured scholars">
      <a href="/directory" class="link shrink-0 text-sm font-medium">All {scholars.length} members →</a>
    </SectionHeading>
    <div class="grid-12 border-b border-ink sm:border-b-0">
      <div class="col-span-4 grid sm:grid-cols-3 sm:gap-6 md:col-span-9 md:col-start-4">
        {featured.map((s, i) => <ScholarCard scholar={s} eager={i < 3} />)}
      </div>
    </div>
  </section>

  <section class="wrap pb-20 md:pb-28">
    <SectionHeading index="02" label="Register" title="All members, A–Z" />
    <div class="grid-12">
      <div class="col-span-4 columns-2 gap-6 md:col-span-9 md:col-start-4 md:columns-3">
        {
          register.map(([letter, members]) => (
            <div class="mb-6 break-inside-avoid">
              <p class="mb-1 border-b border-ink pb-1 text-sm font-bold">{letter}</p>
              <ul>
                {members!.map((m) => (
                  <li class="border-b border-rule">
                    <a href={profileUrl(m)} class="group flex items-baseline justify-between gap-2 py-2 text-sm hover:text-signal">
                      {m.data.name}
                      <span class="opacity-0 transition-opacity group-hover:opacity-100" aria-hidden="true">→</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-mist">
    <div class="wrap grid-12 gap-y-8 py-20 md:py-28">
      <p class="label col-span-4 flex gap-3 md:col-span-3"><span class="tabular text-signal">03</span><span class="text-ink">Contact</span></p>
      <div class="col-span-4 md:col-span-6">
        <h2 class="headline mb-6 text-3xl md:text-5xl">Join the editorial network</h2>
        <p class="max-w-xl text-lg leading-snug text-muted">
          If you are an academic interested in joining our editorial board or have inquiries regarding our scholarly network, please contact the directory administration.
        </p>
        <a href="mailto:directory.admin@panorama-sg.com" class="link mt-4 inline-block text-lg font-medium">directory.admin@panorama-sg.com</a>
      </div>
      <div class="col-span-4 flex flex-col gap-3 md:col-span-3 md:justify-end">
        <a href="mailto:directory.admin@panorama-sg.com" class="btn-solid w-full">
          Email the directory office <span aria-hidden="true">→</span>
        </a>
        <a href="/contact" class="btn-line w-full">All contact options <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <SearchIndex />
</BaseLayout>

<script>
  import { loadIndex, search, escapeHtml } from "../lib/search";

  const input = document.getElementById("global-search") as HTMLInputElement;
  const results = document.getElementById("search-results") as HTMLUListElement;
  const index = loadIndex();
  let active = -1;

  const open = (show: boolean) => {
    results.classList.toggle("hidden", !show);
    input.setAttribute("aria-expanded", String(show));
    if (!show) active = -1;
  };

  const highlight = (text: string, q: string) => {
    const safe = escapeHtml(text);
    const words = q.trim().split(/\s+/).filter(Boolean).map((w) => w.replace(/[.*+?^${}()|[\]\\]/g, "\\$&"));
    return words.length ? safe.replace(new RegExp(`(${words.join("|")})`, "gi"), '<mark class="bg-transparent text-signal">$1</mark>') : safe;
  };

  const render = () => {
    const q = input.value.trim();
    if (!q) return open(false);
    const matches = search(index, q);
    results.innerHTML = matches.length
      ? matches
          .map(
            (m, i) => `<li role="option" id="opt-${i}"><a href="${m.url}" class="block border-b border-rule px-5 py-3.5 transition-colors hover:bg-mist">
              <span class="block font-bold tracking-tight">${highlight(m.name, q)}</span>
              <span class="mt-0.5 block text-sm text-muted">${highlight(m.affiliation, q)}</span></a></li>`,
          )
          .join("") +
        `<li><a href="/directory?q=${encodeURIComponent(q)}" class="block px-5 py-3 text-sm font-medium text-muted hover:text-signal">Show all results in the directory →</a></li>`
      : `<li class="px-5 py-4 text-sm text-muted">No matches. Browse the <a class="link" href="/directory">full directory</a>.</li>`;
    active = -1;
    open(true);
  };

  const options = () => [...results.querySelectorAll<HTMLElement>("[role=option]")];
  const move = (dir: number) => {
    const opts = options();
    if (!opts.length) return;
    active = (active + dir + opts.length) % opts.length;
    opts.forEach((o, i) => o.firstElementChild!.classList.toggle("bg-mist", i === active));
    input.setAttribute("aria-activedescendant", opts[active].id);
    opts[active].scrollIntoView({ block: "nearest" });
  };

  input.addEventListener("input", render);
  input.addEventListener("focus", render);
  input.addEventListener("keydown", (e) => {
    if (e.key === "ArrowDown") (e.preventDefault(), move(1));
    else if (e.key === "ArrowUp") (e.preventDefault(), move(-1));
    else if (e.key === "Enter") {
      const target = options()[active]?.querySelector("a") ?? results.querySelector("a");
      if (target) location.href = target.getAttribute("href")!;
    } else if (e.key === "Escape") open(false);
  });
  document.addEventListener("click", (e) => {
    if (!document.getElementById("home-search")!.contains(e.target as Node)) open(false);
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "/" && document.activeElement !== input) (e.preventDefault(), input.focus());
  });
</script>
