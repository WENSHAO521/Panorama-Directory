---
import { getImage } from "astro:assets";
import Portrait from "../../components/Portrait.astro";
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProfileSection from "../../components/ProfileSection.astro";
import MemberEntry from "../../components/MemberEntry.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import Icon from "../../components/Icon.astro";
import { getFeatured, journalsOf, clothOf, type Scholar } from "../../lib/scholars";

export async function getStaticPaths() {
  const all = await getFeatured(Infinity);
  return all.map((scholar, i) => ({
    params: { slug: scholar.id },
    // "More from the board": the next three scholars in featured order.
    props: { scholar, more: [1, 2, 3].map((n) => all[(i + n) % all.length]) },
  }));
}

interface Props {
  scholar: Scholar;
  more: Scholar[];
}

const { scholar, more } = Astro.props;
const d = scholar.data;
const { Content } = await render(scholar);
const journals = journalsOf(scholar);
const anchors = [
  { id: "biography", title: "Biography" },
  ...d.sections.map((sec, i) => ({ id: `section-${i + 1}`, title: sec.title ?? "Areas of Expertise" })),
];
const og = d.photo ? await getImage({ src: d.photo, width: 800, format: "jpg" }) : undefined;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: d.name,
  ...(d.nativeName && { alternateName: d.nativeName }),
  jobTitle: d.role,
  affiliation: { "@type": "Organization", name: d.affiliation },
  description: d.summary,
  ...(og && { image: new URL(og.src, Astro.site).href }),
  url: new URL(`/board/${scholar.id}`, Astro.site).href,
  knowsAbout: d.keywords,
  sameAs: d.identifiers?.map((i) => i.href),
  memberOf: { "@type": "Organization", name: "Panorama Scholarly Group" },
};
---

<BaseLayout title={`${d.name} | Academic Profile`} description={d.summary} active="directory" image={og?.src} type="profile">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <div class="border-b border-rule">
    <nav class="wrap flex h-10 items-center" aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-1 text-sm text-muted">
        <li><a href="/" class="transition-colors hover:text-ink">Home</a></li>
        <li aria-hidden="true"><Icon name="chevron_right" class="text-base!" /></li>
        <li><a href="/directory" class="transition-colors hover:text-ink">Editorial board</a></li>
        <li aria-hidden="true"><Icon name="chevron_right" class="text-base!" /></li>
        <li class="text-ink" aria-current="page">{d.name}</li>
      </ol>
    </nav>
  </div>

  <div class="wrap grid gap-10 py-10 md:py-14 lg:grid-cols-12 lg:gap-16">
    <aside class="lg:col-span-4">
      <div class="flex flex-col gap-6 sm:flex-row lg:sticky lg:top-24 lg:flex-col">
        <Portrait
          scholar={scholar}
          widths={[288, 384, 576]}
          sizes="(min-width: 1024px) 320px, 160px"
          class="w-40 rounded-lg sm:w-48 lg:w-full"
          loading="eager"
          fetchpriority="high"
        />
        <dl class="min-w-0 grow divide-y divide-rule border-y border-rule text-sm">
          <div class="py-3">
            <dt class="label mb-1">Position</dt>
            <dd>{d.role}</dd>
          </div>
          <div class="py-3">
            <dt class="label mb-1">Affiliation</dt>
            <dd>{d.affiliation}</dd>
          </div>
          {journals.length > 0 && (
            <div class="py-3">
              <dt class="label mb-1">{journals.length === 1 ? "Journal" : "Journals"}</dt>
              <dd class="space-y-1">
                {journals.map((j) => (
                  <p class="flex items-center gap-2">
                    <span class="size-2 shrink-0 rounded-[2px]" style={`background:${clothOf(j.key)}`} aria-hidden="true" />
                    <span class="italic">{j.title}</span>
                  </p>
                ))}
              </dd>
            </div>
          )}
          {d.identifiers?.map((id) => (
            <div class="py-3">
              <dt class="label mb-1">{id.label}</dt>
              <dd>
                <a href={id.href} target="_blank" rel="noopener noreferrer" class="link idnum inline-flex items-center gap-2">
                  {id.label === "ORCID" && <span class="size-2 rounded-full bg-orcid" aria-hidden="true" />}
                  {id.value}
                </a>
              </dd>
            </div>
          ))}
          {d.email && (
            <div class="py-3">
              <dt class="label mb-1">Email</dt>
              <dd class="break-all">
                <a href={`mailto:${d.email}`} class="link">{d.email}</a>
              </dd>
            </div>
          )}
        </dl>
      </div>
    </aside>

    <div class="min-w-0 lg:col-span-8">
      <header class="mb-12 border-b border-rule pb-10">
        <p class="kicker mb-3">{d.role}</p>
        <h1 class="mb-3 text-[2.5rem] leading-[1.05] font-medium tracking-[-0.03em] md:text-[3.5rem]">
          {d.name}
          {d.nativeName && <span class="ml-2 text-[0.6em] font-normal tracking-normal text-muted" lang="zh">{d.nativeName}</span>}
        </h1>
        <p class="mb-6 max-w-2xl text-lg leading-relaxed text-muted">{d.headline ?? d.affiliation}</p>
        <ul class="mb-8 flex flex-wrap gap-2" aria-label="Research fields">
          {d.keywords.map((k) => <li><a href={`/directory?q=${encodeURIComponent(k)}`} class="tag h-7 px-2.5 text-sm transition-colors hover:border-ink/25 hover:bg-surface">{k}</a></li>)}
        </ul>
        <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
          {d.email && (
            <a href={`mailto:${d.email}`} class="btn-primary">
              <Icon name="mail" class="text-lg!" /> Contact researcher
            </a>
          )}
          {anchors.length > 1 && (
            <nav aria-label="On this page">
              <ul class="flex flex-wrap gap-x-5 gap-y-2 text-sm">
                {anchors.map((a) => (
                  <li><a href={`#${a.id}`} class="text-muted underline decoration-rule underline-offset-4 transition-colors hover:text-ink hover:decoration-ink/40">{a.title}</a></li>
                ))}
              </ul>
            </nav>
          )}
        </div>
      </header>

      <div class="space-y-16">
        <section id="biography" class="scroll-mt-24">
          <SectionHeading kicker="Profile" title="Biography" />
          <div class="prose-bio max-w-[44rem] text-[1.0625rem] leading-relaxed text-ink/90">
            <Content />
          </div>
        </section>
        {d.sections.map((section, i) => <ProfileSection section={section} id={`section-${i + 1}`} />)}
      </div>
    </div>
  </div>

  <section class="border-t border-rule bg-surface">
    <div class="wrap py-16">
      <SectionHeading kicker="Editorial network" title="More from the board">
        <a href="/directory" class="link text-sm">Full editorial board</a>
      </SectionHeading>
      <div class="grid gap-4 md:grid-cols-3">
        {more.map((s) => <div class="rounded-lg border border-rule bg-paper px-5 transition-colors duration-150 hover:border-ink/25"><MemberEntry scholar={s} /></div>)}
      </div>
    </div>
  </section>
</BaseLayout>
