---
import { Image, getImage } from "astro:assets";
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProfileSection from "../../components/ProfileSection.astro";
import ScholarCard from "../../components/ScholarCard.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import { getFeatured, type Scholar } from "../../lib/scholars";

export async function getStaticPaths() {
  const all = await getFeatured(Infinity);
  return all.map((scholar, i) => ({
    params: { slug: scholar.id },
    // "More from the board": the next three scholars in featured order.
    props: { scholar, more: [1, 2, 3].map((n) => all[(i + n) % all.length]) },
  }));
}

interface Props {
  scholar: Scholar;
  more: Scholar[];
}

const { scholar, more } = Astro.props;
const d = scholar.data;
const { Content } = await render(scholar);
const og = await getImage({ src: d.photo, width: 800, format: "jpg" });

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: d.name,
  ...(d.nativeName && { alternateName: d.nativeName }),
  jobTitle: d.role,
  affiliation: { "@type": "Organization", name: d.affiliation },
  description: d.summary,
  image: new URL(og.src, Astro.site).href,
  url: new URL(`/board/${scholar.id}`, Astro.site).href,
  knowsAbout: d.keywords,
  sameAs: d.identifiers?.map((i) => i.href),
  memberOf: { "@type": "Organization", name: "Panorama Scholarly Group" },
};
---

<BaseLayout title={`${d.name} | Academic Profile`} description={d.summary} active="directory" image={og.src} type="profile">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <nav class="wrap pt-6 md:pt-8" aria-label="Breadcrumb">
    <ol class="label flex gap-2">
      <li><a href="/directory" class="link">Directory</a></li>
      <li aria-hidden="true">/</li>
      <li class="text-ink" aria-current="page">{d.name}</li>
    </ol>
  </nav>

  <section class="wrap grid-12 gap-y-10 pt-10 pb-20 md:pt-16 md:pb-28">
    <header class="col-span-4 md:col-span-9 md:col-start-4 md:row-start-1">
      <p class="label mb-4 text-ink">{d.role}</p>
      <h1 class="headline mb-4 text-[clamp(2.75rem,7vw,6rem)]">{d.name}</h1>
      {d.nativeName && <p class="mb-4 text-2xl text-muted" lang="zh">{d.nativeName}</p>}
      <p class="text-xl md:text-2xl">{d.headline ?? d.affiliation}</p>
    </header>

    <aside class="col-span-4 md:col-span-3 md:col-start-1 md:row-span-2 md:row-start-1">
      <div class="md:sticky md:top-24">
        <div class="aspect-[4/5] max-w-[16rem] overflow-hidden bg-mist md:max-w-none">
          <Image
            src={d.photo}
            alt={`Portrait of ${d.name}`}
            widths={[320, 480, 640]}
            sizes="(min-width: 768px) 300px, 256px"
            class="h-full w-full object-cover"
            style={`view-transition-name: portrait-${scholar.id}`}
            loading="eager"
            fetchpriority="high"
          />
        </div>

        <dl class="mt-6 border-t-2 border-ink text-sm">
          <div class="border-b border-rule py-3">
            <dt class="label">Affiliation</dt>
            <dd>{d.affiliation}</dd>
          </div>
          {
            d.identifiers?.map((id) => (
              <div class="border-b border-rule py-3">
                <dt class="label">{id.label}</dt>
                <dd>
                  <a href={id.href} target="_blank" rel="noopener noreferrer" class="link tabular font-mono text-[0.8125rem]">
                    {id.value} ↗
                  </a>
                </dd>
              </div>
            ))
          }
          {
            d.email && (
              <div class="border-b border-rule py-3">
                <dt class="label">Email</dt>
                <dd class="break-all">
                  <a href={`mailto:${d.email}`} class="link">{d.email}</a>
                </dd>
              </div>
            )
          }
        </dl>
        {
          d.email && (
            <a href={`mailto:${d.email}`} class="btn-solid mt-4 w-full">
              Contact researcher <span aria-hidden="true">→</span>
            </a>
          )
        }
      </div>
    </aside>

    <div class="col-span-4 md:col-span-9 md:col-start-4">
      <div class="grid gap-y-3 border-t-2 border-ink pt-4 md:grid-cols-9 md:gap-x-6 md:gap-y-8">
        <p class="label text-ink md:col-span-2">Biography</p>
        <div class="prose-bio max-w-[42rem] text-[1.0625rem] leading-relaxed md:col-span-7">
          <Content />
        </div>
        <p class="label mt-6 text-ink md:col-span-2 md:mt-0">Research fields</p>
        <ul class="flex flex-wrap gap-x-1 gap-y-2 md:col-span-7" aria-label="Research fields">
          {d.keywords.map((k, i) => <li class="text-sm">{k}{i < d.keywords.length - 1 && <span class="text-faint"> ·</span>}</li>)}
        </ul>
      </div>
    </div>
  </section>

  {
    d.sections.length > 0 && (
      <div class="wrap space-y-20 pb-20 md:space-y-28 md:pb-28">
        {d.sections.map((section, i) => (
          <ProfileSection section={section} index={String(i + 1).padStart(2, "0")} />
        ))}
      </div>
    )
  }

  <section class="bg-mist">
    <div class="wrap py-20 md:py-28">
      <SectionHeading label="Editorial network" title="More from the board">
        <a href="/directory" class="link shrink-0 text-sm font-medium">All members →</a>
      </SectionHeading>
      <div class="grid-12">
        <div class="col-span-4 grid border-b border-ink sm:grid-cols-3 sm:gap-6 sm:border-b-0 md:col-span-9 md:col-start-4">
          {more.map((s) => <ScholarCard scholar={s} />)}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
