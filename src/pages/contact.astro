---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";

const channels = [
  {
    title: "Editorial Directory Administration",
    text: "For updates to scholar profiles, directory corrections, ORCID-related matters, or general directory questions.",
    email: "directory.admin@panorama-sg.com",
  },
  {
    title: "Publishing & Institutional Partnerships",
    text: "For inquiries relating to journal development, institutional cooperation, special issues, and scholarly publishing partnerships.",
    email: "partnerships@panorama-sg.com",
  },
  {
    title: "General Contact",
    text: "For general editorial, policy, or administrative questions related to Panorama Scholarly Group.",
    email: "contact@panorama-sg.com",
  },
];
---

<BaseLayout
  title="Contact Us"
  description="Contact the Panorama Scholarly Group directory administration, partnerships team or general office."
  active="contact"
>
  <section class="mx-auto max-w-6xl px-5 py-20 md:px-8 md:py-32">
    <p class="eyebrow mb-6">Administration & Support</p>
    <h1 class="display mb-8 text-5xl md:text-7xl">Contact Us</h1>
    <p class="max-w-2xl border-l-2 border-ink pl-5 text-lg leading-relaxed font-light text-ink/75">
      Whether you are a researcher with directory inquiries, an academic interested in editorial participation, or an institution seeking publishing or collaboration information, we welcome your correspondence.
    </p>
  </section>

  <section class="border-t border-rule bg-mist">
    <div class="mx-auto grid max-w-6xl gap-12 px-5 py-20 md:grid-cols-12 md:gap-16 md:px-8 md:py-24">
      <div class="divide-y divide-rule border-y border-ink md:col-span-7">
        {
          channels.map((c) => (
            <div class="py-8">
              <h2 class="mb-2 text-xl font-semibold">{c.title}</h2>
              <p class="mb-5 max-w-lg text-sm leading-relaxed font-light text-muted">{c.text}</p>
              <a href={`mailto:${c.email}`} class="group inline-flex items-center gap-2 border-b border-ink pb-1 text-xs font-semibold tracking-[0.12em] uppercase">
                {c.email}
                <Icon name="arrow_forward" class="text-sm! transition-transform group-hover:translate-x-1" />
              </a>
            </div>
          ))
        }
      </div>

      <div class="flex flex-col justify-between border border-ink bg-paper p-8 md:col-span-5 md:p-10">
        <div>
          <Icon name="location_city" class="mb-6 text-4xl!" />
          <h2 class="display mb-5 text-2xl md:text-3xl">Administrative and Operational Contact</h2>
          <address class="mb-8 text-sm leading-relaxed font-light text-muted not-italic">
            Panorama Scholarly Group<br />
            Room 1508, 15/F., Office Tower Two, Grand Plaza,<br />
            625 Nathan Road, Kowloon, Hong Kong
          </address>
          <p class="mb-8 text-xs leading-relaxed text-faint italic">
            Selected journals within the group hold ISSNs assigned through the German ISSN Centre. Administrative and operational correspondence is coordinated through the contact information listed on this page.
          </p>
        </div>
        <a href="https://panorama-sg.com/" target="_blank" rel="noopener noreferrer" class="btn-ghost w-full">
          Visit Official Publishing Platform
          <Icon name="open_in_new" class="text-base!" />
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
