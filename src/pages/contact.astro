---
import BaseLayout from "../layouts/BaseLayout.astro";

const channels = [
  {
    title: "Editorial Directory Administration",
    text: "For updates to scholar profiles, directory corrections, ORCID-related matters, or general directory questions.",
    email: "directory.admin@panorama-sg.com",
  },
  {
    title: "Publishing & Institutional Partnerships",
    text: "For inquiries relating to journal development, institutional cooperation, special issues, and scholarly publishing partnerships.",
    email: "partnerships@panorama-sg.com",
  },
  {
    title: "General Contact",
    text: "For general editorial, policy, or administrative questions related to Panorama Scholarly Group.",
    email: "contact@panorama-sg.com",
  },
];
---

<BaseLayout
  title="Contact Us"
  description="Contact the Panorama Scholarly Group directory administration, partnerships team or general office."
  active="contact"
>
  <section class="wrap grid-12 gap-y-6 pt-14 pb-14 md:pt-24 md:pb-20">
    <p class="label col-span-4 md:col-span-3 md:pt-3">Administration & support</p>
    <div class="col-span-4 md:col-span-9">
      <h1 class="headline mb-8 text-[clamp(3rem,8vw,6.5rem)]">Contact Us<span class="text-signal">.</span></h1>
      <p class="max-w-2xl text-lg leading-snug md:text-2xl">
        Whether you are a researcher with directory inquiries, an academic interested in editorial participation, or an institution seeking publishing or collaboration information, we welcome your correspondence.
      </p>
    </div>
  </section>

  <section class="wrap pb-20 md:pb-28">
    <ol class="border-t-2 border-ink">
      {
        channels.map((c, i) => (
          <li class="grid-12 gap-y-3 border-b border-rule py-8">
            <span class="label tabular col-span-4 text-signal md:col-span-3">0{i + 1}</span>
            <div class="col-span-4 md:col-span-5">
              <h2 class="mb-2 text-xl font-bold tracking-tight">{c.title}</h2>
              <p class="text-sm leading-relaxed text-muted">{c.text}</p>
            </div>
            <div class="col-span-4 md:col-span-4 md:text-right">
              <a href={`mailto:${c.email}`} class="link text-lg font-medium break-all md:text-xl">{c.email}</a>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="bg-mist">
    <div class="wrap grid-12 gap-y-8 py-20 md:py-28">
      <p class="label col-span-4 text-ink md:col-span-3">Administrative and operational contact</p>
      <address class="col-span-4 text-xl leading-snug not-italic md:col-span-5 md:text-2xl">
        Panorama Scholarly Group<br />
        Room 1508, 15/F., Office Tower Two, Grand Plaza,<br />
        625 Nathan Road, Kowloon, Hong Kong
      </address>
      <div class="col-span-4 flex flex-col justify-between gap-6 md:col-span-4">
        <p class="text-sm leading-relaxed text-muted">
          Selected journals within the group hold ISSNs assigned through the German ISSN Centre. Administrative and operational correspondence is coordinated through the contact information listed on this page.
        </p>
        <a href="https://panorama-sg.com/" target="_blank" rel="noopener noreferrer" class="btn-line w-full">
          Visit Official Publishing Platform <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
