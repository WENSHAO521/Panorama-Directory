---
import BaseLayout from "../layouts/BaseLayout.astro";
import DirectoryRow from "../components/DirectoryRow.astro";
import SearchIndex from "../components/SearchIndex.astro";
import Icon from "../components/Icon.astro";
import { getBoard, getScholars, nameInitials, journalsOf, journalRolesOf, ALL_JOURNALS } from "../lib/scholars";

const board = await getBoard();
const scholars = await getScholars();
const total = scholars.length;
// Only journals that have at least one member here, with their member counts.
const journalCounts = ALL_JOURNALS.map((j) => ({ ...j, count: scholars.filter((s) => journalsOf(s).includes(j)).length })).filter((j) => j.count);
const letters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ".split("");
const available = new Set(board.flatMap((g) => g.members.flatMap((s) => nameInitials(s.data.name))));
---

<BaseLayout
  title="Editorial Board"
  description="The editorial board of Panorama Scholarly Group: editors-in-chief, executive and editorial board members, searchable by name, institution and research field."
  active="directory"
>
  <section class="border-b border-rule">
    <div class="wrap grid gap-8 py-12 md:py-16 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <p class="kicker mb-2">Editorial directory</p>
        <h1 class="mb-3 text-[2.5rem] leading-[1.05] font-medium tracking-[-0.03em] md:text-[3.5rem]">Editorial board</h1>
        <p class="max-w-2xl text-muted">
          Editors, board members and editorial staff of Panorama Scholarly Group journals, listed by editorial role.
        </p>
      </div>
      <div class="lg:col-span-5">
        <label for="directory-search" class="sr-only">Search members</label>
        <div class="flex h-12 items-center rounded-lg border border-ink/15 bg-paper px-4 transition-colors focus-within:border-brand-600 focus-within:ring-4 focus-within:ring-brand-600/10">
          <Icon name="search" class="text-faint" />
          <input
            type="search"
            id="directory-search"
            autocomplete="off"
            class="h-full w-full border-0 bg-transparent px-3 text-base focus:ring-0 focus:outline-none"
            placeholder="Search name, institution or field"
          />
        </div>
      </div>
    </div>
  </section>

  <div class="wrap grid gap-10 py-10 md:py-12 lg:grid-cols-12">
    <aside class="lg:col-span-3">
      <div class="space-y-8 lg:sticky lg:top-24">
        <fieldset>
          <legend class="mb-2 text-sm font-medium">Editorial role</legend>
          <ul class="space-y-1 text-sm">
            {
              board.map((g) => (
                <li>
                  <label class="flex h-8 cursor-pointer items-center gap-3">
                    <input type="checkbox" class="tier-box size-4 rounded-sm border-rule text-brand focus:ring-brand-600/30" value={g.key} checked />
                    <span class="grow">{g.title}</span>
                    <span class="tabular text-faint">{g.members.length}</span>
                  </label>
                </li>
              ))
            }
          </ul>
        </fieldset>

        <div>
          <label for="journal-filter" class="mb-2 block text-sm font-medium">Journal</label>
          <select id="journal-filter" class="h-10 w-full rounded-md border border-rule bg-paper px-3 text-sm focus:border-brand-600 focus:ring-4 focus:ring-brand-600/10">
            <option value="">All journals</option>
            {journalCounts.map((j) => <option value={j.key}>{j.title} ({j.count})</option>)}
          </select>
        </div>

        <fieldset>
          <legend class="mb-2 text-sm font-medium">Name starts with</legend>
          <div class="grid grid-cols-7 gap-1" id="alphabet-filter">
            <button type="button" data-letter="ALL" aria-pressed="true" class="alpha-btn col-span-2 h-8 text-xs font-medium">All</button>
            {
              letters.map((l) => (
                <button type="button" data-letter={l} aria-pressed="false" disabled={!available.has(l)} class="alpha-btn h-8 text-xs font-medium">
                  {l}
                </button>
              ))
            }
          </div>
        </fieldset>
      </div>
    </aside>

    <div class="lg:col-span-9">
      <p id="result-count" class="tabular mb-6 text-sm text-muted" aria-live="polite">Showing all {total} members</p>

      <div class="space-y-16">
        {
          board.map((g) => (
            <section class="tier" data-tier={g.key} aria-labelledby={`tier-${g.key}`}>
              <h2 id={`tier-${g.key}`} class="flex items-baseline gap-2 border-b-2 border-brand pb-3 text-xl font-medium tracking-tight text-brand">
                {g.title}
                <span class="tier-count tabular text-sm font-normal text-faint">({g.members.length})</span>
              </h2>
              <div class="hidden grid-cols-[3rem_minmax(0,1fr)_minmax(0,1.2fr)_11rem] gap-x-6 border-b border-rule py-2 text-xs text-faint md:grid" aria-hidden="true">
                <span />
                <span>Name and role</span>
                <span>Affiliation</span>
                <span>ORCID iD</span>
              </div>
              <div class="tier-list flex flex-col divide-y divide-rule">
                {g.members.map((s) => (
                  <div class="member" data-id={s.id} data-initials={nameInitials(s.data.name).join("")} data-journals={journalsOf(s).map((j) => j.key).join(" ")} data-roles={JSON.stringify(journalRolesOf(s))} data-role={s.data.role} data-tier={g.key}>
                    <DirectoryRow scholar={s} />
                  </div>
                ))}
              </div>
            </section>
          ))
        }
      </div>

      <div id="empty-state" hidden class="rounded-lg border border-dashed border-rule px-6 py-14 text-center">
        <p class="mb-2 font-medium">No members match these filters</p>
        <button type="button" id="reset-filters" class="link text-sm">Clear all filters</button>
      </div>
    </div>
  </div>

  <SearchIndex />
</BaseLayout>

<style>
  .alpha-btn {
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-sm);
    color: var(--color-ink);
    transition: border-color 150ms var(--ease-out), background-color 150ms var(--ease-out), color 150ms var(--ease-out);
  }
  .alpha-btn:hover:not(:disabled) {
    border-color: color-mix(in srgb, var(--color-ink) 25%, transparent);
    background: var(--color-surface);
  }
  .alpha-btn[aria-pressed="true"] {
    background: var(--color-brand);
    border-color: var(--color-brand);
    color: var(--color-paper);
  }
  .alpha-btn:disabled {
    color: var(--color-rule);
    cursor: default;
  }
</style>

<script>
  import { loadIndex, search } from "../lib/search";

  const input = document.getElementById("directory-search") as HTMLInputElement;
  const count = document.getElementById("result-count")!;
  const empty = document.getElementById("empty-state")!;
  const tiers = [...document.querySelectorAll<HTMLElement>(".tier")];
  const tierBoxes = [...document.querySelectorAll<HTMLInputElement>(".tier-box")];
  const letterBtns = [...document.querySelectorAll<HTMLButtonElement>(".alpha-btn")];
  const index = loadIndex();
  const members = [...document.querySelectorAll<HTMLElement>(".member")];
  const listOf = new Map(tiers.map((t) => [t.dataset.tier!, t.querySelector<HTMLElement>(".tier-list")!]));
  const byName = new Map(index.map((e) => [e.id, e.name]));
  // Same rules as TIERS and roleRank in src/lib/scholars.ts.
  const tierOfRole = (r: string) =>
    /editor-in-chief/i.test(r) ? "chief" : /^executive editorial board/i.test(r) ? "executive" : /editorial board member|chair of the editorial board/i.test(r) ? "board" : "office";
  const roleRank = (r: string) => (/^(editor-in-chief|chair of the)/i.test(r) ? 0 : /^co-editor/i.test(r) ? 1 : /^deputy/i.test(r) ? 2 : 3);

  // With a journal chosen, each member shows and is grouped by their role on
  // that journal, not by their highest role anywhere.
  function placeMembers(journal: string) {
    const placed = members.map((el) => {
      const role = journal ? (JSON.parse(el.dataset.roles!)[journal] ?? el.dataset.role!) : el.dataset.role!;
      el.querySelector(".member-role")!.textContent = role;
      return { el, role, tier: journal ? tierOfRole(role) : el.dataset.tier! };
    });
    placed
      .sort((a, b) => roleRank(a.role) - roleRank(b.role) || byName.get(a.el.dataset.id!)!.localeCompare(byName.get(b.el.dataset.id!)!))
      .forEach((p) => listOf.get(p.tier)?.append(p.el));
  }
  const total = index.length;
  let letter = "ALL";

  const journalSel = document.getElementById("journal-filter") as HTMLSelectElement;
  const params = new URLSearchParams(location.search);
  input.value = params.get("q") ?? "";
  journalSel.value = params.get("journal") ?? "";
  if (journalSel.selectedIndex < 0) journalSel.value = "";

  function apply() {
    const q = input.value.trim();
    const ranked = search(index, q).map((e) => e.id);
    const rank = new Map(ranked.map((id, i) => [id, i]));
    const activeTiers = new Set(tierBoxes.filter((b) => b.checked).map((b) => b.value));
    const journal = journalSel.value;
    placeMembers(journal);
    let shown = 0;
    for (const tier of tiers) {
      let inTier = 0;
      for (const el of tier.querySelectorAll<HTMLElement>(".member")) {
        const ok =
          activeTiers.has(tier.dataset.tier!) &&
          rank.has(el.dataset.id!) &&
          (!journal || el.dataset.journals!.split(" ").includes(journal)) &&
          (letter === "ALL" || el.dataset.initials!.includes(letter));
        el.hidden = !ok;
        // While searching, best matches first within each role group.
        el.style.order = q ? String(rank.get(el.dataset.id!) ?? 0) : "";
        if (ok) inTier++;
      }
      tier.hidden = inTier === 0;
      tier.querySelector(".tier-count")!.textContent = `(${inTier})`;
      shown += inTier;
    }
    empty.hidden = shown > 0;
    count.textContent = shown === total ? `Showing all ${total} members` : `Showing ${shown} of ${total} members`;

    const url = new URL(location.href);
    q ? url.searchParams.set("q", q) : url.searchParams.delete("q");
    journal ? url.searchParams.set("journal", journal) : url.searchParams.delete("journal");
    history.replaceState(null, "", url);
  }

  letterBtns.forEach((btn) =>
    btn.addEventListener("click", () => {
      letter = btn.dataset.letter!;
      letterBtns.forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
      apply();
    }),
  );
  tierBoxes.forEach((b) => b.addEventListener("change", apply));
  input.addEventListener("input", apply);
  journalSel.addEventListener("change", apply);
  document.getElementById("reset-filters")!.addEventListener("click", () => {
    input.value = "";
    journalSel.value = "";
    tierBoxes.forEach((b) => (b.checked = true));
    letterBtns[0].click();
  });

  apply();
</script>
