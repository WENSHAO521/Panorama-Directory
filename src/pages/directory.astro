---
import BaseLayout from "../layouts/BaseLayout.astro";
import MemberEntry from "../components/MemberEntry.astro";
import SearchIndex from "../components/SearchIndex.astro";
import Icon from "../components/Icon.astro";
import { getBoard, getScholars, nameInitials } from "../lib/scholars";

const board = await getBoard();
const total = (await getScholars()).length;
const letters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ".split("");
const available = new Set(board.flatMap((g) => g.members.flatMap((s) => nameInitials(s.data.name))));
---

<BaseLayout
  title="Editorial Board"
  description="The editorial board of Panorama Scholarly Group: editors-in-chief, executive and editorial board members, searchable by name, institution and research field."
  active="directory"
>
  <section class="border-b border-rule bg-surface">
    <div class="wrap py-10 md:py-14">
      <p class="kicker mb-2">Editorial Directory</p>
      <h1 class="mb-3 text-3xl font-semibold tracking-tight md:text-[2.75rem]">Editorial Board</h1>
      <p class="max-w-2xl text-muted">
        Editors, board members and editorial staff of Panorama Scholarly Group journals, listed by editorial role.
      </p>
    </div>
  </section>

  <div class="wrap grid gap-10 py-10 md:py-12 lg:grid-cols-12">
    <aside class="lg:col-span-3">
      <div class="space-y-6 lg:sticky lg:top-28">
        <div>
          <label for="directory-search" class="mb-2 block text-sm font-semibold">Search members</label>
          <div class="flex items-center rounded-md border border-rule bg-paper px-3 focus-within:border-brand-600 focus-within:ring-2 focus-within:ring-brand-600/15">
            <Icon name="search" class="text-faint" />
            <input
              type="search"
              id="directory-search"
              autocomplete="off"
              class="w-full border-0 bg-transparent px-2 py-2.5 text-sm placeholder:text-faint focus:ring-0 focus:outline-none"
              placeholder="Name, institution, field…"
            />
          </div>
        </div>

        <fieldset>
          <legend class="mb-2 text-sm font-semibold">Editorial role</legend>
          <ul class="space-y-1.5 text-sm">
            {
              board.map((g) => (
                <li>
                  <label class="flex cursor-pointer items-center gap-2.5">
                    <input type="checkbox" class="tier-box size-4 rounded-sm border-rule text-brand focus:ring-brand-600/30" value={g.key} checked />
                    <span class="grow">{g.title}</span>
                    <span class="tabular text-faint">{g.members.length}</span>
                  </label>
                </li>
              ))
            }
          </ul>
        </fieldset>

        <fieldset>
          <legend class="mb-2 text-sm font-semibold">Name starts with</legend>
          <div class="grid grid-cols-7 gap-1" id="alphabet-filter">
            <button type="button" data-letter="ALL" aria-pressed="true" class="alpha-btn col-span-2 h-8 rounded-sm text-xs font-medium">All</button>
            {
              letters.map((l) => (
                <button type="button" data-letter={l} aria-pressed="false" disabled={!available.has(l)} class="alpha-btn h-8 rounded-sm text-xs font-medium">
                  {l}
                </button>
              ))
            }
          </div>
        </fieldset>
      </div>
    </aside>

    <div class="lg:col-span-9">
      <p id="result-count" class="tabular mb-6 text-sm text-muted" aria-live="polite">Showing all {total} members</p>

      <div class="space-y-12">
        {
          board.map((g) => (
            <section class="tier" data-tier={g.key} aria-labelledby={`tier-${g.key}`}>
              <h2 id={`tier-${g.key}`} class="flex items-baseline gap-2 border-b-2 border-brand pb-2 text-lg font-semibold text-brand">
                {g.title}
                <span class="tier-count tabular text-sm font-normal text-faint">({g.members.length})</span>
              </h2>
              <div class="tier-list grid divide-y divide-rule md:grid-cols-2 md:gap-x-10 md:divide-y-0">
                {g.members.map((s) => (
                  <div class="member md:border-b md:border-rule" data-id={s.id} data-initials={nameInitials(s.data.name).join("")}>
                    <MemberEntry scholar={s} />
                  </div>
                ))}
              </div>
            </section>
          ))
        }
      </div>

      <div id="empty-state" hidden class="rounded-lg border border-dashed border-rule px-6 py-14 text-center">
        <p class="mb-2 font-semibold">No members match these filters.</p>
        <button type="button" id="reset-filters" class="link text-sm">Clear all filters</button>
      </div>
    </div>
  </div>

  <SearchIndex />
</BaseLayout>

<style>
  .alpha-btn {
    border: 1px solid var(--color-rule);
    color: var(--color-ink);
    transition: border-color 120ms, background-color 120ms, color 120ms;
  }
  .alpha-btn:hover:not(:disabled) {
    border-color: var(--color-brand-600);
    color: var(--color-brand-600);
  }
  .alpha-btn[aria-pressed="true"] {
    background: var(--color-brand);
    border-color: var(--color-brand);
    color: var(--color-paper);
  }
  .alpha-btn:disabled {
    color: var(--color-rule);
    cursor: default;
  }
</style>

<script>
  import { loadIndex, search } from "../lib/search";

  const input = document.getElementById("directory-search") as HTMLInputElement;
  const count = document.getElementById("result-count")!;
  const empty = document.getElementById("empty-state")!;
  const tiers = [...document.querySelectorAll<HTMLElement>(".tier")];
  const tierBoxes = [...document.querySelectorAll<HTMLInputElement>(".tier-box")];
  const letterBtns = [...document.querySelectorAll<HTMLButtonElement>(".alpha-btn")];
  const index = loadIndex();
  const total = index.length;
  let letter = "ALL";

  input.value = new URLSearchParams(location.search).get("q") ?? "";

  function apply() {
    const q = input.value.trim();
    const ranked = search(index, q).map((e) => e.id);
    const rank = new Map(ranked.map((id, i) => [id, i]));
    const activeTiers = new Set(tierBoxes.filter((b) => b.checked).map((b) => b.value));
    let shown = 0;
    for (const tier of tiers) {
      let inTier = 0;
      for (const el of tier.querySelectorAll<HTMLElement>(".member")) {
        const ok =
          activeTiers.has(tier.dataset.tier!) &&
          rank.has(el.dataset.id!) &&
          (letter === "ALL" || el.dataset.initials!.includes(letter));
        el.hidden = !ok;
        // While searching, best matches first within each role group.
        el.style.order = q ? String(rank.get(el.dataset.id!) ?? 0) : "";
        if (ok) inTier++;
      }
      tier.hidden = inTier === 0;
      tier.querySelector(".tier-count")!.textContent = `(${inTier})`;
      shown += inTier;
    }
    empty.hidden = shown > 0;
    count.textContent = shown === total ? `Showing all ${total} members` : `Showing ${shown} of ${total} members`;

    const url = new URL(location.href);
    q ? url.searchParams.set("q", q) : url.searchParams.delete("q");
    history.replaceState(null, "", url);
  }

  letterBtns.forEach((btn) =>
    btn.addEventListener("click", () => {
      letter = btn.dataset.letter!;
      letterBtns.forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
      apply();
    }),
  );
  tierBoxes.forEach((b) => b.addEventListener("change", apply));
  input.addEventListener("input", apply);
  document.getElementById("reset-filters")!.addEventListener("click", () => {
    input.value = "";
    tierBoxes.forEach((b) => (b.checked = true));
    letterBtns[0].click();
  });

  apply();
</script>
