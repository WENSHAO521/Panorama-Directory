---
import BaseLayout from "../layouts/BaseLayout.astro";
import ScholarCard from "../components/ScholarCard.astro";
import ScholarRow from "../components/ScholarRow.astro";
import SearchIndex from "../components/SearchIndex.astro";
import Icon from "../components/Icon.astro";
import { getScholars, nameInitials } from "../lib/scholars";

const scholars = await getScholars();
const letters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ".split("");
const available = new Set(scholars.flatMap((s) => nameInitials(s.data.name)));
---

<BaseLayout
  title="Editorial Directory"
  description="Browse every editor, adviser and editorial board member of Panorama Scholarly Group, searchable by name, institution and research field."
  active="directory"
>
  <section class="mx-auto max-w-6xl px-5 pt-16 pb-10 md:px-8 md:pt-24">
    <p class="eyebrow mb-5">Academic Network</p>
    <h1 class="display mb-12 text-5xl md:text-7xl">Editorial Directory</h1>

    <div class="grid gap-6 border-b border-ink pb-6 md:grid-cols-[1fr_auto] md:items-stretch">
      <div class="flex items-center border border-ink bg-paper focus-within:outline-2 focus-within:outline-offset-3 focus-within:outline-ink">
        <Icon name="search" class="mx-4 text-2xl!" />
        <label for="directory-search" class="sr-only">Filter members</label>
        <input
          type="search"
          id="directory-search"
          autocomplete="off"
          class="w-full border-0 bg-transparent px-0 py-3.5 text-lg font-light placeholder:text-faint focus:ring-0 focus:outline-none"
          placeholder="Filter by name, institution, keyword or publication"
        />
      </div>
      <div class="flex items-center gap-2" role="group" aria-label="Layout">
        <button type="button" data-view="grid" aria-pressed="true" class="view-btn flex h-12 w-14 items-center md:h-full justify-center border border-ink transition-colors aria-pressed:bg-ink aria-pressed:text-paper" title="Grid view">
          <Icon name="grid_view" /><span class="sr-only">Grid view</span>
        </button>
        <button type="button" data-view="list" aria-pressed="false" class="view-btn flex h-12 w-14 items-center md:h-full justify-center border border-ink transition-colors aria-pressed:bg-ink aria-pressed:text-paper" title="List view">
          <Icon name="view_list" /><span class="sr-only">List view</span>
        </button>
      </div>
    </div>

    <div class="no-scrollbar -mx-5 overflow-x-auto px-5 md:mx-0 md:px-0" role="group" aria-label="Filter by initial">
      <div class="flex min-w-max items-center gap-0.5 py-4" id="alphabet-filter">
        <button type="button" data-letter="ALL" aria-pressed="true" class="alpha-btn px-3 py-2 text-xs font-semibold">All</button>
        {
          letters.map((l) => (
            <button type="button" data-letter={l} aria-pressed="false" disabled={!available.has(l)} class="alpha-btn px-2.5 py-2 text-xs font-semibold">
              {l}
            </button>
          ))
        }
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 pb-24 md:px-8">
    <p id="result-count" class="eyebrow tabular mb-8" aria-live="polite">{scholars.length} editorial members</p>

    <div id="view-grid" class="grid gap-x-5 border-b border-ink sm:grid-cols-2 sm:gap-y-5 sm:border-b-0 lg:grid-cols-3 xl:grid-cols-4">
      {
        scholars.map((s, i) => (
          <div data-id={s.id} data-initials={nameInitials(s.data.name).join("")} data-reveal style={`--reveal-i: ${i % 4}`}>
            <ScholarCard scholar={s} eager={i < 4} />
          </div>
        ))
      }
    </div>
    <div id="view-list" class="flex flex-col gap-5" hidden>
      {
        scholars.map((s) => (
          <div data-id={s.id} data-initials={nameInitials(s.data.name).join("")}>
            <ScholarRow scholar={s} />
          </div>
        ))
      }
    </div>

    <div id="empty-state" hidden class="border border-rule bg-mist px-6 py-16 text-center">
      <p class="display mb-3 text-2xl">No members found</p>
      <button type="button" id="reset-filters" class="link-underline text-[11px] font-semibold uppercase tracking-[0.16em]">Clear filters</button>
    </div>
  </section>

  <SearchIndex />
</BaseLayout>

<style>
  .alpha-btn {
    border-bottom: 2px solid transparent;
    color: var(--color-muted);
    transition: color 150ms, border-color 150ms;
  }
  .alpha-btn:hover:not(:disabled),
  .alpha-btn[aria-pressed="true"] {
    color: var(--color-ink);
    border-color: var(--color-ink);
  }
  .alpha-btn:disabled {
    color: var(--color-rule);
    cursor: default;
  }
  .no-scrollbar {
    scrollbar-width: none;
  }
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  import { loadIndex, search } from "../lib/search";

  const input = document.getElementById("directory-search") as HTMLInputElement;
  const count = document.getElementById("result-count")!;
  const empty = document.getElementById("empty-state")!;
  const views = { grid: document.getElementById("view-grid")!, list: document.getElementById("view-list")! };
  const letterBtns = [...document.querySelectorAll<HTMLButtonElement>(".alpha-btn")];
  const viewBtns = [...document.querySelectorAll<HTMLButtonElement>(".view-btn")];
  const index = loadIndex();
  const total = index.length;
  let letter = "ALL";

  const params = new URLSearchParams(location.search);
  input.value = params.get("q") ?? "";

  function setView(view: "grid" | "list") {
    views.grid.hidden = view !== "grid";
    views.list.hidden = view !== "list";
    viewBtns.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.view === view)));
    try {
      localStorage.setItem("directory-view", view);
    } catch {}
  }

  function apply() {
    const q = input.value.trim();
    const ranked = search(index, q).map((e) => e.id);
    const rank = new Map(ranked.map((id, i) => [id, i]));
    let shown = 0;
    for (const container of Object.values(views)) {
      const items = [...container.children] as HTMLElement[];
      for (const el of items) {
        const ok = rank.has(el.dataset.id!) && (letter === "ALL" || el.dataset.initials!.includes(letter));
        el.hidden = !ok;
        // While searching, best matches first; otherwise alphabetical.
        el.style.order = q ? String(rank.get(el.dataset.id!) ?? 0) : "";
        if (ok && container === views.grid) shown++;
      }
    }
    empty.hidden = shown > 0;
    count.textContent = shown === total ? `${total} editorial members` : `Showing ${shown} of ${total} editorial members`;

    const url = new URL(location.href);
    q ? url.searchParams.set("q", q) : url.searchParams.delete("q");
    history.replaceState(null, "", url);
  }

  letterBtns.forEach((btn) =>
    btn.addEventListener("click", () => {
      letter = btn.dataset.letter!;
      letterBtns.forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
      apply();
    }),
  );
  viewBtns.forEach((b) => b.addEventListener("click", () => setView(b.dataset.view as "grid" | "list")));
  input.addEventListener("input", apply);
  document.getElementById("reset-filters")!.addEventListener("click", () => {
    input.value = "";
    letterBtns[0].click();
  });

  try {
    if (localStorage.getItem("directory-view") === "list") setView("list");
  } catch {}
  apply();
</script>
