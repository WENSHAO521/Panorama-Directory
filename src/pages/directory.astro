---
import BaseLayout from "../layouts/BaseLayout.astro";
import ScholarCard from "../components/ScholarCard.astro";
import ScholarRow from "../components/ScholarRow.astro";
import SearchIndex from "../components/SearchIndex.astro";
import Icon from "../components/Icon.astro";
import { getScholars, nameInitials } from "../lib/scholars";

const scholars = await getScholars();
const letters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ".split("");
const available = new Set(scholars.flatMap((s) => nameInitials(s.data.name)));
---

<BaseLayout
  title="Editorial Directory"
  description="Browse every editor, adviser and editorial board member of Panorama Scholarly Group, searchable by name, institution and research field."
  active="directory"
>
  <section class="wrap grid-12 gap-y-6 pt-14 pb-10 md:pt-24 md:pb-14">
    <p class="label col-span-4 md:col-span-3 md:pt-3">Academic network</p>
    <h1 class="headline col-span-4 text-[clamp(3rem,8vw,6.5rem)] md:col-span-9">Editorial Directory<span class="text-signal">.</span></h1>
  </section>

  <section class="wrap">
    <div class="grid-12 gap-y-4 border-t-2 border-ink pt-4">
      <label for="directory-search" class="label col-span-4 md:col-span-3 md:pt-3">Filter</label>
      <div class="col-span-4 flex items-center border-b-2 border-ink focus-within:border-signal md:col-span-6">
        <Icon name="search" class="mr-3 text-2xl!" />
        <input
          type="search"
          id="directory-search"
          autocomplete="off"
          class="w-full border-0 bg-transparent px-0 py-2.5 text-lg placeholder:text-faint focus:ring-0 focus:outline-none md:text-xl"
          placeholder="Name, institution, field or publication"
        />
      </div>
      <div class="col-span-4 flex md:col-span-3 md:justify-end" role="group" aria-label="Layout">
        <button type="button" data-view="list" aria-pressed="true" class="view-btn border border-ink px-4 py-2 text-sm font-medium aria-pressed:bg-ink aria-pressed:text-paper">Index</button>
        <button type="button" data-view="grid" aria-pressed="false" class="view-btn -ml-px border border-ink px-4 py-2 text-sm font-medium aria-pressed:bg-ink aria-pressed:text-paper">Portraits</button>
      </div>
    </div>

    <div class="grid-12 mt-6 gap-y-2">
      <p class="label col-span-4 md:col-span-3 md:pt-1.5">Initial</p>
      <div class="col-span-4 -mx-5 overflow-x-auto px-5 md:col-span-9 md:mx-0 md:px-0 no-scrollbar" role="group" aria-label="Filter by initial">
        <div class="flex min-w-max" id="alphabet-filter">
          <button type="button" data-letter="ALL" aria-pressed="true" class="alpha-btn h-8 px-2.5 text-sm font-medium">All</button>
          {
            letters.map((l) => (
              <button type="button" data-letter={l} aria-pressed="false" disabled={!available.has(l)} class="alpha-btn h-8 w-8 text-sm font-medium">
                {l}
              </button>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="wrap pt-12 pb-24 md:pb-32">
    <p id="result-count" class="label tabular mb-3" aria-live="polite">{scholars.length} members</p>

    <div id="view-list" class="flex flex-col border-t-2 border-ink">
      <div class="hidden border-b border-ink py-2 text-xs font-medium text-muted md:grid md:grid-cols-12 md:gap-x-6" aria-hidden="true">
        <span class="col-span-2">No.</span>
        <span class="col-span-3">Name</span>
        <span class="col-span-2">Role</span>
        <span class="col-span-3">Institution</span>
        <span class="col-span-2">Fields</span>
      </div>
      {
        scholars.map((s, i) => (
          <div data-id={s.id} data-initials={nameInitials(s.data.name).join("")}>
            <ScholarRow scholar={s} index={i + 1} />
          </div>
        ))
      }
    </div>
    <div id="view-grid" class="grid border-b border-ink sm:grid-cols-2 sm:gap-x-6 sm:gap-y-12 sm:border-b-0 sm:border-t-2 sm:border-ink sm:pt-6 lg:grid-cols-4" hidden>
      {
        scholars.map((s, i) => (
          <div data-id={s.id} data-initials={nameInitials(s.data.name).join("")}>
            <ScholarCard scholar={s} eager={i < 4} />
          </div>
        ))
      }
    </div>

    <div id="empty-state" hidden class="border-b border-rule py-16">
      <p class="headline mb-4 text-3xl">No members found.</p>
      <button type="button" id="reset-filters" class="link text-sm font-medium">Clear filters</button>
    </div>
  </section>

  <SearchIndex />
</BaseLayout>

<style>
  .alpha-btn {
    color: var(--color-ink);
    transition: color 120ms, background-color 120ms;
  }
  .alpha-btn:hover:not(:disabled) {
    color: var(--color-signal);
  }
  .alpha-btn[aria-pressed="true"] {
    background: var(--color-ink);
    color: var(--color-paper);
  }
  .alpha-btn:disabled {
    color: var(--color-rule);
    cursor: default;
  }
  .no-scrollbar {
    scrollbar-width: none;
  }
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  import { loadIndex, search } from "../lib/search";

  const input = document.getElementById("directory-search") as HTMLInputElement;
  const count = document.getElementById("result-count")!;
  const empty = document.getElementById("empty-state")!;
  const views = { grid: document.getElementById("view-grid")!, list: document.getElementById("view-list")! };
  const letterBtns = [...document.querySelectorAll<HTMLButtonElement>(".alpha-btn")];
  const viewBtns = [...document.querySelectorAll<HTMLButtonElement>(".view-btn")];
  const index = loadIndex();
  const total = index.length;
  let letter = "ALL";

  const params = new URLSearchParams(location.search);
  input.value = params.get("q") ?? "";

  function setView(view: "grid" | "list") {
    views.grid.hidden = view !== "grid";
    views.list.hidden = view !== "list";
    viewBtns.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.view === view)));
    try {
      localStorage.setItem("directory-view", view);
    } catch {}
  }

  function apply() {
    const q = input.value.trim();
    const ranked = search(index, q).map((e) => e.id);
    const rank = new Map(ranked.map((id, i) => [id, i]));
    let shown = 0;
    for (const container of Object.values(views)) {
      const items = [...container.querySelectorAll<HTMLElement>(":scope > [data-id]")];
      for (const el of items) {
        const ok = rank.has(el.dataset.id!) && (letter === "ALL" || el.dataset.initials!.includes(letter));
        el.hidden = !ok;
        // While searching, best matches first; otherwise alphabetical.
        el.style.order = q ? String(rank.get(el.dataset.id!) ?? 0) : "";
        if (ok && container === views.list) shown++;
      }
    }
    empty.hidden = shown > 0;
    count.textContent = shown === total ? `${total} members` : `${shown} of ${total} members`;

    const url = new URL(location.href);
    q ? url.searchParams.set("q", q) : url.searchParams.delete("q");
    history.replaceState(null, "", url);
  }

  letterBtns.forEach((btn) =>
    btn.addEventListener("click", () => {
      letter = btn.dataset.letter!;
      letterBtns.forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
      apply();
    }),
  );
  viewBtns.forEach((b) => b.addEventListener("click", () => setView(b.dataset.view as "grid" | "list")));
  input.addEventListener("input", apply);
  document.getElementById("reset-filters")!.addEventListener("click", () => {
    input.value = "";
    letterBtns[0].click();
  });

  try {
    if (localStorage.getItem("directory-view") === "grid") setView("grid");
  } catch {}
  apply();
</script>
