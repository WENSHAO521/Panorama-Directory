---
// A scholar's photo in a 4:5 frame. With `photoCrop` (written by
// scripts/portrait-crops.py) it shows that window of the original photo, so
// every portrait is framed head-and-shoulders whatever the source shot.
import { Image } from "astro:assets";
import type { Scholar } from "../lib/scholars";

interface Props {
  scholar: Scholar;
  widths: number[];
  sizes: string;
  class?: string;
  loading?: "eager" | "lazy";
  fetchpriority?: "high";
}
const { scholar, widths, sizes, class: className, loading = "lazy", fetchpriority } = Astro.props;
const { name, photo, photoCrop: crop } = scholar.data;

const pct = (n: number) => `${+(n * 100).toFixed(3)}%`;
let style = `view-transition-name: portrait-${scholar.id}`;
let srcWidths = widths;
if (crop) {
  const height = (crop.width * photo.width) / (4 / 5) / photo.height;
  style += `;width:${pct(1 / crop.width)};height:${pct(1 / height)};left:${pct(-crop.x / crop.width)};top:${pct(-crop.y / height)}`;
  // The frame shows part of the photo, so request a proportionally larger file.
  srcWidths = [...new Set(widths.map((w) => Math.min(photo.width, Math.round(w / crop.width))))];
}
---

<div class:list={["relative aspect-[4/5] shrink-0 overflow-hidden bg-surface", className]}>
  <Image
    src={photo}
    alt={`Portrait of ${name}`}
    widths={srcWidths}
    sizes={crop ? sizes.replace(/(\d+(?:\.\d+)?)(px|vw)/g, (_, n, u) => `${Math.round(n / crop.width)}${u}`) : sizes}
    class:list={[crop ? "absolute max-w-none" : "h-full w-full object-cover"]}
    style={style}
    loading={loading}
    fetchpriority={fetchpriority}
  />
</div>
