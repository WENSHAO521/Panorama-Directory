---
import { Image } from "astro:assets";
import { profileUrl, type Scholar } from "../lib/scholars";

interface Props {
  scholar: Scholar;
  index: number;
}
const { scholar, index } = Astro.props;
const { name, affiliation, role, photo, keywords } = scholar.data;
const href = profileUrl(scholar);
---

<!-- One row of the index table: No. / portrait / name / role / institution / fields. -->
<article class="group relative flex items-start gap-4 border-b border-rule py-4 transition-colors hover:bg-mist md:grid md:grid-cols-12 md:gap-x-6">
  <span class="tabular label hidden pt-0.5 md:col-span-1 md:block">{String(index).padStart(2, "0")}</span>
  <div class="aspect-[4/5] w-12 shrink-0 overflow-hidden bg-mist md:col-span-1">
    <Image src={photo} alt="" widths={[96]} sizes="48px" class="h-full w-full object-cover" />
  </div>
  <div class="min-w-0 md:contents">
    <h3 class="font-bold tracking-tight md:col-span-3">
      <a href={href} class="after:absolute after:inset-0 group-hover:text-signal">{name}</a>
    </h3>
    <p class="text-sm md:col-span-2">{role}</p>
    <p class="text-sm text-muted md:col-span-3">{affiliation}</p>
    <p class="hidden text-sm text-muted md:col-span-2 md:block">{keywords.slice(0, 2).join(", ")}</p>
  </div>
</article>
