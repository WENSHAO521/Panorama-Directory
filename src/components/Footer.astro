---
const year = new Date().getFullYear();
---

<footer class="mt-auto border-t border-rule bg-surface text-muted">
  <div class="wrap grid gap-10 py-16 md:grid-cols-12">
    <div class="md:col-span-5">
      <p class="mb-3 font-medium text-ink">Panorama Scholarly Group Editorial Directory</p>
      <p class="max-w-sm text-sm leading-relaxed">
        The international network of editors, academic advisers and scholarly contributors of Panorama Scholarly Group.
      </p>
    </div>
    <div class="md:col-span-2 md:col-start-7">
      <p class="mb-3 text-sm font-medium text-ink">Directory</p>
      <ul class="space-y-2 text-sm">
        <li><a class="transition-colors hover:text-ink" href="/directory">Editorial board</a></li>
        <li><a class="transition-colors hover:text-ink" href="/about">About</a></li>
        <li><a class="transition-colors hover:text-ink" href="/contact">Contact</a></li>
        <li><a class="transition-colors hover:text-ink" href="/edit">Board member sign-in</a></li>
      </ul>
    </div>
    <div class="md:col-span-4">
      <p class="mb-3 text-sm font-medium text-ink">Publisher</p>
      <ul class="space-y-2 text-sm">
        <li><a class="transition-colors hover:text-ink" href="https://panorama-sg.com/" target="_blank" rel="noopener noreferrer">panorama-sg.com</a></li>
        <li><a class="transition-colors hover:text-ink" href="mailto:directory.admin@panorama-sg.com">directory.admin@panorama-sg.com</a></li>
        <li>Room 1508, 15/F., Office Tower Two, Grand Plaza, 625 Nathan Road, Kowloon, Hong Kong</li>
      </ul>
    </div>
  </div>
  <div class="border-t border-rule">
    <div class="wrap flex flex-wrap items-center justify-between gap-x-6 gap-y-2 py-5 text-xs text-faint">
      <p>© {year} Panorama Scholarly Group Editorial Directory. All rights reserved.</p>
      <a class="transition-colors hover:text-ink" href="/admin/">Editorial office</a>
    </div>
  </div>
</footer>
