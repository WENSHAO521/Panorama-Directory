---
import { Image } from "astro:assets";
import logo from "../assets/logo.png";
import Icon from "./Icon.astro";

interface Props {
  active?: "home" | "directory" | "about" | "contact";
}
const { active } = Astro.props;
const links = [
  { key: "home", label: "Home", href: "/" },
  { key: "directory", label: "Directory", href: "/directory" },
  { key: "about", label: "About", href: "/about" },
  { key: "contact", label: "Contact", href: "/contact" },
] as const;
---

<header class="sticky top-0 z-50 border-b border-ink bg-paper">
  <nav class="wrap grid-12 h-16 items-center md:h-[4.5rem]" aria-label="Main">
    <a href="/" class="col-span-2 flex items-center md:col-span-3" aria-label="Panorama Scholarly Group Editorial Directory, home">
      <Image src={logo} alt="" class="h-11 w-auto md:h-12" height={96} loading="eager" />
    </a>

    <ul class="col-span-9 col-start-4 hidden h-full items-stretch md:flex">
      {
        links.map((l) => (
          <li class="flex-1 border-l border-rule last:border-r">
            <a
              href={l.href}
              aria-current={active === l.key ? "page" : undefined}
              class:list={[
                "group flex h-full items-center gap-2 px-4 text-sm font-medium transition-colors",
                active === l.key ? "text-ink" : "text-muted hover:text-ink",
              ]}
            >
              <span
                class:list={[
                  "size-2 transition-colors",
                  active === l.key ? "bg-signal" : "bg-transparent group-hover:bg-ink",
                ]}
                aria-hidden="true"
              />
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>

    <details class="group col-span-2 col-start-3 justify-self-end md:hidden">
      <summary class="flex h-10 cursor-pointer list-none items-center gap-2 text-sm font-medium [&::-webkit-details-marker]:hidden">
        <span class="group-open:hidden">Menu</span>
        <span class="hidden group-open:inline">Close</span>
        <Icon name="menu" class="group-open:hidden" />
        <Icon name="close" class="hidden group-open:inline-block" />
      </summary>
      <ul class="absolute inset-x-0 top-full border-b border-ink bg-paper">
        {
          links.map((l, i) => (
            <li class="border-t border-rule">
              <a
                href={l.href}
                aria-current={active === l.key ? "page" : undefined}
                class="flex items-baseline gap-4 px-5 py-4 text-2xl font-bold tracking-tight"
              >
                <span class:list={["tabular text-sm font-medium", active === l.key ? "text-signal" : "text-faint"]}>0{i + 1}</span>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </details>
  </nav>
</header>
