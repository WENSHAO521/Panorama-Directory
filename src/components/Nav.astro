---
import { Image } from "astro:assets";
import logo from "../assets/logo.png";
import Icon from "./Icon.astro";

interface Props {
  active?: "home" | "directory" | "about" | "contact";
}
const { active } = Astro.props;
const links = [
  { key: "home", label: "Home", href: "/" },
  { key: "directory", label: "Directory", href: "/directory" },
  { key: "about", label: "About", href: "/about" },
  { key: "contact", label: "Contact", href: "/contact" },
] as const;
---

<header class="sticky top-0 z-50 border-b border-ink bg-paper/90 backdrop-blur-md">
  <nav class="mx-auto flex h-18 max-w-6xl items-center justify-between px-5 md:h-20 md:px-8" aria-label="Main">
    <a href="/" class="flex items-center" aria-label="Panorama Scholarly Group Editorial Directory, home">
      <Image src={logo} alt="" class="h-12 w-auto md:h-14" height={112} loading="eager" />
    </a>

    <ul class="hidden items-center gap-9 md:flex">
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              aria-current={active === l.key ? "page" : undefined}
              class:list={[
                "relative py-2 text-[11px] font-semibold uppercase tracking-[0.16em] transition-colors",
                "after:absolute after:inset-x-0 after:-bottom-px after:h-0.5 after:origin-left after:bg-ink after:transition-transform after:duration-300",
                active === l.key
                  ? "text-ink after:scale-x-100"
                  : "text-muted after:scale-x-0 hover:text-ink hover:after:scale-x-100",
              ]}
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>

    <details class="group md:hidden">
      <summary class="flex size-11 cursor-pointer list-none items-center justify-center border border-ink [&::-webkit-details-marker]:hidden" aria-label="Menu">
        <Icon name="menu" class="group-open:hidden" />
        <Icon name="close" class="hidden group-open:inline-block" />
      </summary>
      <ul class="absolute inset-x-0 top-full border-b border-ink bg-paper px-5 py-2">
        {
          links.map((l) => (
            <li class="border-b border-rule last:border-0">
              <a
                href={l.href}
                aria-current={active === l.key ? "page" : undefined}
                class:list={[
                  "flex items-center justify-between py-4 text-xs font-semibold uppercase tracking-[0.16em]",
                  active === l.key ? "text-ink" : "text-muted",
                ]}
              >
                {l.label}
                <Icon name="arrow_forward" class="text-base!" />
              </a>
            </li>
          ))
        }
      </ul>
    </details>
  </nav>
</header>
