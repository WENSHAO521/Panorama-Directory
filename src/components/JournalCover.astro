---
// A journal's real cover (served by the publishing platform), with the
// number of board members on this site who serve it. The one rich object on
// the home page; everything around it stays quiet. If the image cannot load,
// the frame keeps the journal's colour and title so nothing breaks.
interface Props {
  title: string;
  cover: string;
  thumb?: string;
  cloth: string;
  count: number;
  href: string;
}
const { title, cover, thumb, cloth, count, href } = Astro.props;
---

<a href={href} class="cover group block" aria-label={`${title}: ${count} board members`}>
  <span class="cover-frame" style={`--cloth:${cloth}`}>
    <span class="cover-fallback" aria-hidden="true">{title}</span>
    <img
      src={cover}
      data-fallback={thumb || undefined}
      alt=""
      loading="eager"
      decoding="async"
      referrerpolicy="no-referrer"
      onerror="const f=this.dataset.fallback;if(f){this.removeAttribute('data-fallback');this.src=f}else this.remove()"
    />
  </span>
  <span class="mt-3 block text-sm leading-snug font-medium text-ink italic transition-colors group-hover:text-brand-600">{title}</span>
  <span class="tabular mt-1 block text-xs text-faint">{count} {count === 1 ? "editor" : "editors"} listed</span>
</a>

<style>
  .cover-frame {
    position: relative;
    display: block;
    aspect-ratio: 5 / 7;
    overflow: hidden;
    border-radius: 4px;
    background: var(--cloth);
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.1),
      0 16px 32px -16px rgb(0 0 0 / 0.35);
    transition: transform 180ms var(--ease-out), box-shadow 180ms var(--ease-out);
  }
  .cover-frame img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Issue covers are full wraps (back, spine, front): show the front,
       which is the right-hand part. Front-only thumbnails are unaffected. */
    object-position: right center;
  }
  /* A faint spine highlight so the cover reads as a printed object. */
  .cover-frame::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgb(0 0 0 / 0.18) 0, rgb(255 255 255 / 0.12) 3px, transparent 8px);
    pointer-events: none;
  }
  .cover-fallback {
    position: absolute;
    inset: 16px;
    color: rgb(255 255 255 / 0.9);
    font-size: 15px;
    line-height: 1.25;
    font-weight: 500;
  }
  .cover:hover .cover-frame {
    transform: translateY(-4px);
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.1),
      0 22px 36px -16px rgb(0 0 0 / 0.4);
  }
  .cover:active .cover-frame {
    transform: translateY(-2px) scale(0.99);
  }
</style>
