---
// Researcher identifier links in the style publishers use on board pages:
// the green ORCID iD mark, Web of Science and other profiles, and email.
import Icon from "./Icon.astro";
import type { Scholar } from "../lib/scholars";

interface Props {
  scholar: Scholar;
  size?: "sm" | "md";
  email?: boolean;
}
const { scholar, size = "sm", email = true } = Astro.props;
const ids = scholar.data.identifiers ?? [];
const text = size === "sm" ? "text-xs" : "text-sm";
const short = (label: string) =>
  label === "Web of Science ResearcherID" ? "Web of Science" : label.replace(/ Profile$/, "");
---

<ul class:list={["relative z-10 flex flex-wrap items-center gap-x-4 gap-y-1.5", text]}>
  {
    ids.map((id) => (
      <li>
        <a
          href={id.href}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-muted transition-colors hover:text-brand-600"
          title={`${id.label}: ${id.value}`}
        >
          {id.label === "ORCID" ? (
            <svg viewBox="0 0 32 32" class="size-4 shrink-0" aria-hidden="true">
              <circle cx="16" cy="16" r="16" fill="var(--color-orcid)" />
              <text x="16" y="21.5" fill="#fff" font-family="Arial, Helvetica, sans-serif" font-size="14" font-weight="700" text-anchor="middle">iD</text>
            </svg>
          ) : (
            <span class="flex size-4 shrink-0 items-center justify-center rounded-sm bg-brand text-[9px] font-bold text-paper" aria-hidden="true">
              {id.label === "Web of Science ResearcherID" ? "W" : id.label[0]}
            </span>
          )}
          <span>{id.label === "ORCID" ? id.value : short(id.label)}</span>
        </a>
      </li>
    ))
  }
  {
    email && scholar.data.email && (
      <li>
        <a href={`mailto:${scholar.data.email}`} class="inline-flex items-center gap-1 text-muted transition-colors hover:text-brand-600">
          <Icon name="mail" class="text-base!" />
          <span>Email</span>
        </a>
      </li>
    )
  }
</ul>
