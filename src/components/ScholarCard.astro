---
import { Image } from "astro:assets";
import { profileUrl, type Scholar } from "../lib/scholars";

interface Props {
  scholar: Scholar;
  eager?: boolean;
}
const { scholar, eager = false } = Astro.props;
const { name, affiliation, role, photo } = scholar.data;
const href = profileUrl(scholar);
---

<article class="group relative flex h-full flex-col border border-rule bg-paper transition-colors duration-300 hover:border-ink">
  <div class="aspect-[4/5] overflow-hidden border-b border-rule bg-mist">
    <Image
      src={photo}
      alt={`Portrait of ${name}`}
      widths={[320, 480, 720]}
      sizes="(min-width: 1024px) 340px, (min-width: 640px) 45vw, 90vw"
      class="h-full w-full object-cover grayscale-[35%] transition duration-700 ease-editorial group-hover:scale-[1.03] group-hover:grayscale-0"
      style={`view-transition-name: portrait-${scholar.id}`}
      loading={eager ? "eager" : "lazy"}
    />
  </div>
  <div class="flex grow flex-col p-6">
    <p class="eyebrow mb-3">{role}</p>
    <h3 class="display mb-2 text-2xl">
      <a href={href} class="after:absolute after:inset-0">{name}</a>
    </h3>
    <p class="text-sm font-light text-muted">{affiliation}</p>
    <span class="mt-auto inline-flex items-center gap-1 pt-6 text-[11px] font-semibold uppercase tracking-[0.16em]">
      View profile
      <span class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">→</span>
    </span>
  </div>
</article>
