---
import { Image } from "astro:assets";
import { profileUrl, type Scholar } from "../lib/scholars";

interface Props {
  scholar: Scholar;
  eager?: boolean;
}
const { scholar, eager = false } = Astro.props;
const { name, affiliation, role, photo } = scholar.data;
const href = profileUrl(scholar);
---

<!-- Phones: small portrait beside the text. From sm up: portrait above, text below a rule. -->
<article class="group relative grid h-full grid-cols-[5rem_1fr] gap-4 border-t border-ink py-4 sm:flex sm:flex-col sm:gap-0 sm:border-t-0 sm:py-0">
  <div class="aspect-[4/5] overflow-hidden bg-mist">
    <Image
      src={photo}
      alt={`Portrait of ${name}`}
      widths={[160, 320, 480, 640]}
      sizes="(min-width: 1280px) 300px, (min-width: 640px) 45vw, 80px"
      class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.02]"
      style={`view-transition-name: portrait-${scholar.id}`}
      loading={eager ? "eager" : "lazy"}
    />
  </div>
  <div class="flex grow flex-col sm:mt-4 sm:border-t sm:border-ink sm:pt-3">
    <h3 class="mb-1 flex items-start justify-between gap-3 text-lg leading-tight font-bold tracking-tight">
      <a href={href} class="after:absolute after:inset-0">{name}</a>
      <span class="text-signal opacity-0 transition-opacity group-hover:opacity-100" aria-hidden="true">→</span>
    </h3>
    <p class="text-sm">{role}</p>
    <p class="text-sm text-muted">{affiliation}</p>
  </div>
</article>
