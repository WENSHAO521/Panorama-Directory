---
import type { Scholar } from "../lib/scholars";
import { inline } from "../lib/scholars";
import SectionHeading from "./SectionHeading.astro";
import Icon from "./Icon.astro";

interface Props {
  section: Scholar["data"]["sections"][number];
}
const { section } = Astro.props;
const { layout, columns = 2, compact } = section;
const gridCols = columns === 3 ? "md:grid-cols-3" : "md:grid-cols-2";
---

<div>
  {(section.eyebrow || section.title) && <SectionHeading eyebrow={section.eyebrow} title={section.title} />}

  {
    layout === "list" ? (
      <ol class="divide-y divide-rule border-y border-rule">
        {section.items.map((item) =>
          item.type === "publication" ? (
            <li class="group grid gap-3 py-7 md:grid-cols-[7rem_1fr] md:gap-10">
              <span class="pt-1 font-mono text-xs font-semibold tracking-[0.12em] uppercase">{item.label}</span>
              <div>
                <h3 class="mb-3 text-lg leading-snug font-semibold text-balance">{item.title}</h3>
                {item.authors && <p class="mb-1 text-sm" set:html={inline(item.authors)} />}
                {item.venue && <p class="text-sm text-muted italic" set:html={inline(item.venue)} />}
                {item.link && (
                  <a
                    href={item.link.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="mt-3 inline-flex items-center gap-1 font-mono text-xs text-muted transition-colors hover:text-ink"
                  >
                    {item.link.text}
                    <Icon name="north_east" class="text-sm!" />
                  </a>
                )}
              </div>
            </li>
          ) : null,
        )}
      </ol>
    ) : (
      <div class:list={["grid grid-cols-1 gap-5 md:gap-6", gridCols]}>
        {section.items.map((item) =>
          item.type === "card" ? (
            <div
              class:list={[
                "flex flex-col border border-rule bg-paper transition-colors duration-300 hover:border-ink",
                compact ? "p-6" : "p-8",
                item.centered && "items-center text-center",
              ]}
            >
              {item.icon && <Icon name={item.icon} class:list={[compact ? "mb-3 text-3xl!" : "mb-5 text-4xl!"]} />}
              <h3 class:list={["font-semibold", compact ? "mb-2 text-sm" : "mb-3 text-xl leading-snug"]}>{item.title}</h3>
              {item.entries && (
                <dl class="mt-3 divide-y divide-rule">
                  {item.entries.map((e) => (
                    <div class="py-3 first:pt-0 last:pb-0">
                      <dt class="text-sm font-semibold">{e.title}</dt>
                      <dd class="eyebrow mt-1">{e.meta}</dd>
                    </div>
                  ))}
                </dl>
              )}
              {item.meta?.map((m) => <p class="eyebrow" set:html={inline(m)} />)}
              {item.text?.map((t) => (
                <p class:list={["font-light text-muted", compact ? "text-xs leading-relaxed" : "mt-1 text-sm leading-relaxed"]} set:html={inline(t)} />
              ))}
              {item.list && (
                <ul class="mt-1 list-disc space-y-3 pl-4 text-sm font-light text-muted marker:text-faint">
                  {item.list.map((l) => <li set:html={inline(l)} />)}
                </ul>
              )}
            </div>
          ) : null,
        )}
      </div>
    )
  }
</div>
