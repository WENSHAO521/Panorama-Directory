---
import type { Scholar } from "../lib/scholars";
import { inline } from "../lib/scholars";
import SectionHeading from "./SectionHeading.astro";

interface Props {
  section: Scholar["data"]["sections"][number];
  index: string;
}
const { section, index } = Astro.props;
const { layout, columns = 2, compact } = section;
---

<section>
  <SectionHeading index={index} label={section.eyebrow ?? "Focus"} title={section.title ?? (compact ? "Research focus" : undefined)} />

  {
    layout === "list" ? (
      <ol class="border-t border-ink">
        {section.items.map((item) =>
          item.type === "publication" ? (
            <li class="grid-12 gap-y-2 border-b border-rule py-6">
              <span class="tabular col-span-4 text-sm font-medium md:col-span-3">{item.label}</span>
              <div class="col-span-4 md:col-span-7">
                <h3 class="mb-2 text-lg leading-snug font-bold tracking-tight">{item.title}</h3>
                {item.authors && <p class="text-sm" set:html={inline(item.authors)} />}
                {item.venue && <p class="text-sm text-muted italic" set:html={inline(item.venue)} />}
              </div>
              <div class="col-span-4 md:col-span-2 md:text-right">
                {item.link && (
                  <a href={item.link.href} target="_blank" rel="noopener noreferrer" class="link font-mono text-xs break-all text-muted">
                    {item.link.text} ↗
                  </a>
                )}
              </div>
            </li>
          ) : null,
        )}
      </ol>
    ) : (
      <div class:list={["grid gap-x-6 gap-y-10 border-t border-ink pt-6 md:grid-cols-12"]}>
        {section.items.map((item) =>
          item.type === "card" ? (
            <div class:list={["md:col-span-4", columns === 2 && !compact && "md:col-span-6"]}>
              <h3 class:list={["mb-3 font-bold tracking-tight", compact ? "text-base" : "text-xl leading-snug"]}>{item.title}</h3>
              {item.entries && (
                <dl class="border-t border-rule">
                  {item.entries.map((e) => (
                    <div class="border-b border-rule py-3">
                      <dt class="text-sm font-medium">{e.title}</dt>
                      <dd class="text-sm text-muted">{e.meta}</dd>
                    </div>
                  ))}
                </dl>
              )}
              {item.meta?.map((m) => <p class="text-sm text-muted" set:html={inline(m)} />)}
              {item.text?.map((t) => <p class="mt-1 text-sm leading-relaxed text-muted" set:html={inline(t)} />)}
              {item.list && (
                <ul class="border-t border-rule">
                  {item.list.map((l) => <li class="border-b border-rule py-3 text-sm leading-relaxed" set:html={inline(l)} />)}
                </ul>
              )}
            </div>
          ) : null,
        )}
      </div>
    )
  }
</section>
